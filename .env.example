# ===========================================
# ArcReports — Configuração de ambiente
# Copie este arquivo para .env e preencha
# ===========================================
# Não versionar .env, local.env ou ldap.env. Permissões recomendadas: 0600.
# Sintaxe python-dotenv: use aspas simples para valores com espaços, # ou $.
# O instalador rejeita ${...}, pois python-dotenv interpola essa sequência.

# --- Banco local (MariaDB) ---
# Banco principal do portal; não apontar para uma origem.
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=3306
LOCAL_DB_NAME=reports
LOCAL_DB_USER=arcreports
LOCAL_DB_PASS=SENHA_FORTE_AQUI

# Usuário administrativo (cria databases)
# Deve ter ALL PRIVILEGES ON *.* WITH GRANT OPTION no MariaDB LOCAL.
LOCAL_DB_ADMIN_USER=portal_db_admin
LOCAL_DB_ADMIN_PASS=SENHA_FORTE_AQUI

# Usuário de gestão de contas de banco
# CREATE USER ON *.* e SELECT ON reports.* WITH GRANT OPTION.
LOCAL_DB_USER_ADMIN_USER=portal_db_user
LOCAL_DB_USER_ADMIN_PASS=SENHA_FORTE_AQUI

# Provisionamento opcional: preencher o par ou deixar ambos vazios.
# Na ausência, o aplicativo usa LOCAL_DB_ADMIN_USER/PASS.
LOCAL_DB_PROVISION_USER=
LOCAL_DB_PROVISION_PASS=

# --- Segurança ---
# Chave secreta — gerar com:
# python3 -c "import secrets; print(secrets.token_hex(32))"
# NUNCA compartilhar ou reutilizar entre instalações.
# NUNCA alterar após a instalação (invalida sessões e credenciais criptografadas).
SECRET_KEY=GERAR_COM_COMANDO_ACIMA
# Alias legado, usado somente se SECRET_KEY estiver vazia. Preferir SECRET_KEY.
APP_SECRET_KEY=
# TTL da validação da sessão; o cookie continua com duração fixa de 8 horas.
SESSION_TTL_HOURS=8

# --- Feature flags ---
# Console SQL administrativo (true/false).
# false desabilita no startup; o administrador pode alterar depois na interface.
SQL_CONSOLE_ENABLED=false
# Limite padrão de linhas para consulta/prévia; não limita toda a replicação.
REPORT_MAX_ROWS=500

# --- Origem GLPI legada (opcional) ---
# Preferir configurar conectores na interface. A conta remota deve ter SÓ SELECT.
# Nunca usar as contas administrativas locais na origem.
GLPI_DB_HOST=localhost
GLPI_DB_PORT=3306
GLPI_DB_NAME=glpi
GLPI_DB_USER=
GLPI_DB_PASS=
