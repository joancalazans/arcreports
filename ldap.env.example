# ArcReports — LDAP opcional
# Copie para ldap.env (0600). Descomente e preencha somente se usar LDAP.
# A interface administrativa persiste a configuração no banco local;
# ldap.env serve de bootstrap quando ainda não há cadastro LDAP no banco.
# LDAP_ENABLED=false
# Host sem ldap:// ou ldaps://.
# LDAP_SERVER=ldap.example.org
# Porta 636 com SSL; 389 para conexão sem SSL.
# LDAP_PORT=636
# LDAP_USE_SSL=true
# Base de busca e conta de bind com permissão de leitura.
# LDAP_BASE_DN='DC=example,DC=org'
# LDAP_BIND_DN='CN=arcreports,OU=Services,DC=example,DC=org'
# LDAP_BIND_PASSWORD='SENHA_FORTE_AQUI'
# {username} é substituído pelo usuário com escape do filtro LDAP.
# LDAP_USER_FILTER='(sAMAccountName={username})'
# O bootstrap aceita texto claro; a aplicação cifra a senha persistida com SECRET_KEY.
# Manter o administrador local para acesso de contingência.
