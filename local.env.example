# ArcReports — administrador local de bootstrap
# Copie para local.env (0600), preencha antes do primeiro startup e não versione.
# Estes valores são lidos de local.env, não de .env.
# Use conta nominal; não use a conta técnica reservada scheduler.
ADMIN_USERNAME=admin_local
ADMIN_PASSWORD=SENHA_FORTE_AQUI
# Uma conta existente com hash não tem a senha redefinida por este arquivo.
# O bootstrap pode reativar/promover a conta indicada a administradora.
